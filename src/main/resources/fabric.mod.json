{
	"schemaVersion": 1,
	"id": "stackplus",
	"version": "${version}",
	"name": "StackPlus",
	"description": "The stack size can be set to a maximum of 1,000,000,000.",
	"authors": [
		"chihalu"
	],
	"contact": {
		"homepage": "https://chihalucoding.github.io/stackplus-release-note/",
		"issues": "https://github.com/ChihaluCoding/stackplus/issues",
		"sources": "https://github.com/ChihaluCoding/stackplus"
	},
	"license": "MIT",
	"icon": "assets/stackplus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"chihalu.stackplus.StackPlus"
		],
		"client": [
			"chihalu.stackplus.StackPlusClient"
		],
		"modmenu": [
			"chihalu.stackplus.modmenu.StackPlusModMenuIntegration"
		],
		"fabric-datagen": [
			"chihalu.stackplus.StackPlusDataGenerator"
		]
	},
	"mixins": [
		"stackplus.mixins.json",
		{
			"config": "stackplus.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=1.21.6 <1.21.7",
		"java": ">=21",
		"fabric-api": "*",
		"modmenu": "*"
	}
}
