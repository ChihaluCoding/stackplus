{
	"schemaVersion": 1,
	"id": "stackplus",
	"version": "${version}",
	"name": "StackPlus",
	"description": "Increase Minecraft stack sizes up to 1,000,000,000 with Mod Menu presets, compact count display, and vanilla-safe handling for damageable items.",
	"authors": [
		"chihalu"
	],
	"contact": {
		"sources": "https://github.com/ChihaluCoding/CustomStackLimit?tab=readme-ov-file"
	},
	"license": "MIT",
	"icon": "assets/stackplus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"chihalu.customstacklimit.CustomStackLimit"
		],
		"client": [
			"chihalu.customstacklimit.CustomStackLimitClient"
		],
		"modmenu": [
			"chihalu.customstacklimit.modmenu.StackPlusModMenuIntegration"
		],
		"fabric-datagen": [
			"chihalu.customstacklimit.CustomStackLimitDataGenerator"
		]
	},
	"mixins": [
		"customstacklimit.mixins.json",
		{
			"config": "customstacklimit.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=1.21.7",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
